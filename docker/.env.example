# Copy to docker/.env. docker-compose auto-loads it from this directory.
# Gitignored — never check the real file in.

# ──────────────────────────── Required ────────────────────────────

# smee.io channel URL set in your GitHub App's "Webhook URL" field.
# Copy from the App settings page or `https://smee.io/<id>`.
SMEE_CHANNEL=https://smee.io/REPLACE_ME

# Postgres owner password. Since roadmap-v3 Phase 6 there is a SINGLE DB
# role: the owner `sbgh`. The daemon (host) connects as the owner —
# it's the sole DB client (migrates at startup, serves /api, runs the
# processor). The handler and CLI are API clients with no DB access.
#
# Generate with `openssl rand -hex 32`. Use hex rather than `-base64`: the
# base64 alphabet includes `/` and `+`, which have special meaning inside a
# Postgres DSN (`postgres://user:pw@host`) and trigger "invalid port number"
# errors from sqlx without obvious warning. Hex is URL-safe end-to-end.
POSTGRES_OWNER_PASSWORD=REPLACE_ME

# ──────────────────────────── Optional ────────────────────────────

# Log filter applied to handler + smee + cli. Verbose by default in dev.
RUST_LOG=info,sbgh_handler=debug,sbgh_smee=debug,sbgh_cli=debug,sqlx=warn,tower_http=warn

# Daemon /api base URL the handler submits webhooks to. The handler
# runs in a container and the daemon on the host, so it's reached via the
# docker host gateway (the compose `host.docker.internal:host-gateway`
# extra_host). The daemon must bind an [api].listen entry on the bridge
# gateway IP (see config.example.daemon.toml). Override only if the
# daemon listens on a non-default port.
SBGH_API_URL=http://host.docker.internal:8787

# Where the handler-owned config directory lives on the host. Bind-mounted
# read-only into the handler container at the same path (/etc/sbgh/handler)
# so file paths in the TOML resolve identically on both sides. Must
# contain:
#   - config.toml       (server + webhook + [api].url + authorization)
#   - secrets.env       (SBGH_WEBHOOK_SECRET + SBGH_API_INGEST_TOKEN —
#                        sourced via env_file). SBGH_API_INGEST_TOKEN must
#                        match the daemon's SBGH_API_INGEST_TOKEN.
# Owner: the `sbgh-handler` host user (default uid 901), mode 0700/0600.
SBGH_HANDLER_CONFIG_DIR=/etc/sbgh/handler

# Host directory bind-mounted at /var/lib/postgresql in the Postgres
# container (PG 18+ wants the parent of the actual data dir so it can
# write its `<MAJOR>/docker/` subdirectory layout for pg_upgrade --link).
# Survives `docker volume prune`. Default lives on the sbgh-meta XFS LV.
# The container runs rootless as uid ${POSTGRES_UID} (see below) and the
# entrypoint skips its usual chown when not root, so the host dir MUST
# exist owned by that same uid before `docker compose up`:
#   sudo install -d -m 0700 -o $POSTGRES_UID -g $POSTGRES_GID /var/lib/sbgh/postgres
POSTGRES_DATA_DIR=/var/lib/sbgh/postgres

# ────────── uid layout ──────────
#
# Four distinct uids, by design — see docker-compose.yml header. Defaults
# are in the low 900s to dodge the common Ubuntu allocations 997
# (systemd-timesync), 998 (systemd-network), and 999 (dnsmasq). Verify
# they're free on your host before applying:
#   getent passwd 900 901 902 903
# If any are taken, pick alternatives and update both this file and the
# host useradd commands in docs/host-bringup.md §3.
#
#   POSTGRES_UID=900     postgres container (overrides image baseline 999)
#   SBGH_UID=901         handler container; must match host
#                        `sbgh-handler` user that owns the bind-mount
#   (host) sbgh=902      daemon binary on the host
#   SBGH_SMEE_UID=903    smee container. No host user needed (smee has
#                        no bind mounts). Distinct from handler purely
#                        for defense-in-depth — see compose header.
#
# If you change SBGH_UID/SBGH_GID, rebuild the handler + smee images:
#   docker compose -f docker/docker-compose.yml build --no-cache
# SBGH_SMEE_UID/SBGH_SMEE_GID are runtime-only — no rebuild needed.

POSTGRES_UID=900
POSTGRES_GID=900

SBGH_UID=901
SBGH_GID=901

SBGH_SMEE_UID=903
SBGH_SMEE_GID=903
