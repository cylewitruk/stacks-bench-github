[Unit]
Description=stacks-bench-github orchestrator (libvirt benchmark runner)
Documentation=https://github.com/cylewitruk/stacks-bench-github
# Wait for the prerequisites the orchestrator immediately touches:
#   - network-online: GitHub API + git fetches
#   - libvirtd:       virsh define/start/destroy
#   - docker:         postgres (job queue) + handler run in containers;
#                     the orchestrator's DB pool retries on failure but we
#                     start after docker so the normal boot order doesn't race.
After=network-online.target libvirtd.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=sbgh
Group=sbgh
WorkingDirectory=/var/lib/sbgh
ExecStart=/usr/local/bin/sbgh-orchestrator

# Restart with a delay on crash so we don't tight-loop if e.g. the DB
# config is wrong. Per-job failures don't crash the orchestrator (they're
# logged + DB-recorded); a Rust panic or unwrap somewhere does.
Restart=on-failure
RestartSec=10s

# Logs go to journald — view with:
#   journalctl -u sbgh-orchestrator -f
#   journalctl -u sbgh-orchestrator -p info --since '1h ago'
StandardOutput=journal
StandardError=journal

# Default RUST_LOG. Override per-host in /etc/systemd/system/sbgh-orchestrator.service.d/override.conf
# (use `systemctl edit sbgh-orchestrator` to create it).
Environment=RUST_LOG=info,sbgh_orchestrator=info,sqlx=warn

# ─── Hardening ──────────────────────────────────────────────────────────
#
# We intentionally do NOT use ProtectSystem= / ProtectHome= /
# PrivateTmp= / ReadWritePaths= here. Those create a private mount
# namespace for the unit, which is fundamentally incompatible with
# how our per-job tmpfs share works:
#
#   - Orchestrator sudo-mounts a tmpfs at /run/sbgh/jobs/<id>/.
#     Inside its private namespace, this is the per-job results dir.
#   - libvirtd spawns virtiofsd to serve that path to the VM.
#     virtiofsd runs in the *host's main namespace* (libvirtd's
#     namespace), not the orchestrator's private one. It sees the
#     empty underlying directory, not our tmpfs.
#   - VM writes through virtio-fs → virtiofsd writes to the underlying
#     directory in the host namespace. The orchestrator looking for
#     those files in its private namespace sees an empty tmpfs.
#
# The result was a 10-minute build VM finishing cleanly with the
# orchestrator reading an empty .phase-log, mis-reported as
# "VM powered off before reporting phase=done".
#
# Filesystem permissions (sbgh is uid 902 — can't touch /usr, /etc,
# /home/* via ownership) and the narrow sudoers allowlist
# (/etc/sudoers.d/sbgh — see docs/host-bringup.md §3) give us most
# of what ProtectSystem= was nominally providing. Kernel-interface
# restrictions don't affect mount namespaces, so we keep those:
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# NoNewPrivileges MUST stay false: sudo is a setuid binary, and our
# orchestrator->sudo->lvcreate chain depends on the privilege change.
NoNewPrivileges=false
RestrictSUIDSGID=false   # see NoNewPrivileges note above

# Resource ceiling. The orchestrator process itself is tiny (~30 MB
# typical); these limits are a tripwire for a runaway leak, not a
# sizing knob. The per-job VMs are libvirt-managed separately and
# unaffected by these.
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
