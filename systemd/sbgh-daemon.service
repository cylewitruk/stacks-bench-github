[Unit]
Description=stacks-bench-github fleet orchestrator
Documentation=https://github.com/cylewitruk/stacks-bench-github
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=sbgh
Group=sbgh
WorkingDirectory=/var/lib/sbgh
ExecStart=/usr/local/bin/sbgh-daemon
Restart=on-failure
RestartSec=10s

# SIGINT requests a graceful fleet drain; SIGTERM is the bounded abort path.
KillSignal=SIGINT
FinalKillSignal=SIGKILL
KillMode=control-group
TimeoutStopSec=180s

RuntimeDirectory=sbgh
RuntimeDirectoryPreserve=yes
UMask=0077
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info,sbgh_daemon=info,sqlx=warn
EnvironmentFile=-/etc/sbgh/daemon/secrets.env

# v25 moved all recipe/driver execution into sbgh-worker. The orchestrator no
# longer needs sudo, libvirt, LVM, device access, or a shared mount namespace.
NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Unix ownership still protects the root-owned configuration/private key.
# The daemon needs this directory writable only for its boot-scoped 0600
# operator cookie (the documented default remains under /etc/sbgh/daemon).
ReadWritePaths=/var/lib/sbgh /run/sbgh /etc/sbgh/daemon
ReadOnlyPaths=/etc/sbgh/fleet
MemoryHigh=512M
MemoryMax=1G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
