# Optional env file for the host `sbgh-daemon` binary — the only component
# you run outside Docker. The handler + smee run in containers (see
# docker/.env.example for those), and `sbgh-cli` is a pure /api client
# (cookie auth, no env needed).
#
# The daemon's canonical config is /etc/sbgh/daemon/config.toml (see
# config.example.daemon.toml). Anything set here OVERRIDES the TOML and
# always wins — keep secrets here rather than in the world-readable file.
# Loaded from ./.env (best-effort) or via `sbgh-daemon --env-file PATH`. In
# production the systemd unit instead reads secrets from
# /etc/sbgh/daemon/secrets.env (EnvironmentFile).
#
# Override the config path itself with SBGH_CONFIG:
# SBGH_CONFIG=/etc/sbgh/daemon/config.toml

# --- Database (owner DSN — the daemon is the sole DB client) ---
DATABASE_URL=postgres://sbgh:REPLACE_ME@127.0.0.1:5432/sbgh

# --- GitHub App (secrets) ---
# Use the App's Client ID (Iv23li...), not the numeric App ID.
SBGH_GH_CLIENT_ID=Iv23liREPLACE_ME
# Absolute path to the App's RSA private key (PEM). File must be 0600.
SBGH_GH_PRIVATE_KEY_PATH=/etc/sbgh/daemon/github-app.private-key.pem
# SBGH_GH_API_BASE_URL=https://api.github.com

# --- /api (the daemon serves this; handler + CLI are clients) ---
# Shared ingest token the handler presents — MUST match the handler's
# SBGH_API_INGEST_TOKEN (env-only on both sides).
SBGH_API_INGEST_TOKEN=REPLACE_ME
# SBGH_API_LISTEN=127.0.0.1:8787,172.17.0.1:8787
# SBGH_API_COOKIE_PATH=/etc/sbgh/daemon/.cookie

# --- VM / LVM / paths ---
# Full surface is in config.example.daemon.toml; every [section].key has an
# SBGH_<SECTION>_<KEY> override. The commonly-overridden ones:
SBGH_VM_GOLDEN_IMAGE=/var/lib/libvirt/images/sbgh-golden-ubuntu24.qcow2
SBGH_LVM_VG=vg0
SBGH_LVM_THINPOOL=thinpool

# --- Logging ---
RUST_LOG=info,sbgh_daemon=debug,sqlx=warn
