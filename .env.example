# Copy to .env (chmod 0600) and fill in real values.
#
# Anything not set in env falls back to the TOML file at $SBGH_CONFIG
# (default: /etc/sbgh/config.toml). Env always wins. Secrets live here.

# Path to layered TOML config (optional).
SBGH_CONFIG=./config.toml

# --- Database ---
DATABASE_URL=postgres://sbgh:sbgh@127.0.0.1:5432/sbgh

# --- Server ---
SBGH_BIND_ADDR=0.0.0.0:8080

# --- GitHub App (secrets) ---
SBGH_GH_APP_ID=000000
# Absolute path to the App's RSA private key (PEM). File must be 0600.
SBGH_GH_PRIVATE_KEY_PATH=/etc/sbgh/github-app.private-key.pem
SBGH_GH_WEBHOOK_SECRET=replace-me-with-a-long-random-string
SBGH_GH_API_BASE_URL=https://api.github.com

# --- Authorization (CSV; env overrides TOML) ---
SBGH_ALLOWED_REPOS=cylewitruk/stacks-core
SBGH_ALLOWED_USERS=
SBGH_ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# --- VM (overrides TOML [vm]) ---
SBGH_VM_GOLDEN_IMAGE=/var/lib/libvirt/images/sbgh-golden-ubuntu24.qcow2
# SBGH_VM_VCPUS=2
# SBGH_VM_MEMORY_GIB=8
# SBGH_VM_BOOT_DISK_GIB=64
# SBGH_VM_JOB_TIMEOUT_SECS=21600
# SBGH_VM_NETWORK=default

# --- Paths (overrides TOML [paths]) ---
# SBGH_JOBS_DIR=/var/lib/sbgh/jobs
# SBGH_GIT_MIRROR=/var/lib/sbgh/git/stacks-core.git
# SBGH_RESULTS_TMPFS_ROOT=/run/sbgh/jobs
# SBGH_RESULTS_ARCHIVE_DIR=/var/lib/sbgh/results
# SBGH_VIRSH_BIN=/usr/bin/virsh

# --- LVM (overrides TOML [lvm]) ---
SBGH_LVM_VG=sbgh-vg
SBGH_LVM_THINPOOL=thinpool
# SBGH_LVM_CHAINSTATE_PREFIX=mainnet-
# SBGH_LVM_SNAPSHOT_GIB=64

# --- Logging ---
RUST_LOG=info,sbgh_handler=debug,sbgh_orchestrator=debug
