      "reason": "epoch",
      "producer_release": "3.0.0.0.0",
      "expected_producer_release": "3.0.0.0.0",
      "target_burn_height": 867866,
      "implements_epoch": "3.0",
      "notes": "Pre-Nakamoto snapshot; actual_epoch should still derive as 2.5."
    },
    {
