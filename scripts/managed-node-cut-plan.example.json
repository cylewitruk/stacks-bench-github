{
  "schema_version": 1,
  "description": "Draft managed-node historical backfill plan. Review producer releases and approximate release cut heights before running on the host.",
  "snapshot_script": "managed-node-snapshot.sh",
  "operator_notes": [
    "This plan is intentionally argv-hook based. Replace install_release with the host-local script that checks out, builds, and installs a release build of stacks-node.",
    "Epoch activation heights are the known hard boundaries. Release rows with estimated=true use rough LLM-derived Bitcoin heights and should be treated as operational cut points, not consensus boundaries.",
    "For pre-activation snapshots, target_burn_height is activation_height - 1 so the snapshot metadata's actual_epoch is the epoch the chainstate is still running under.",
    "The base LV starting point determines first-cut duration. For real backfills, seed the base LV from a trusted archive/snapshot near the first cut instead of syncing from genesis if possible.",
    "If a long run fails, resume with managed-node-backfill.sh run --plan <plan> --from <event>. Use the current cut unless the snapshot completed, then use the next cut."
  ],
  "defaults": {
    "vg": "vg0",
    "base_lv": "stacks-node-mainnet",
    "base_mount": "/var/lib/stacks-chainstate",
    "snapshot_prefix": "mainnet-node-",
    "service": "stacks-node.service",
    "api_url": "http://127.0.0.1:20443/v2/info",
    "metadata_dir": "/var/lib/sbgh/chainstate-snapshots",
    "quiesce": "umount",
    "snapshot_mount_options": "ro,nouuid,norecovery",
    "poll_secs": 30,
    "restart_after_snapshot": false,
    "validate_snapshot": true,
    "reason": "release"
  },
  "hooks": {
    "install_release": [
      "/usr/local/sbin/sbgh-install-stacks-node-release",
      "{{producer_release}}"
    ],
    "start_node": [
      "sudo",
      "systemctl",
      "start",
      "{{service}}"
    ],
    "after_snapshot": []
  },
  "cuts": [
    {
