#!/bin/bash
# Runs repository build scripts and stacks-inspect only inside this disposable
# VM. The host supplies a typed plan and attempt-scoped snapshot devices.
set -euo pipefail

RESULTS=/results
SRC=/opt/stacks-core
SCCACHE=/var/cache/sccache
PHASE_LOG="$RESULTS/.phase-log"
phase() { printf '%s %s\n' "$(date +%s)" "$1" >> "$PHASE_LOG"; sync; }
die() { phase error; echo "ERROR: $*" >&2; exit 1; }

mkdir -p "$RESULTS" "$SRC" "$SCCACHE"
mount -t virtiofs results "$RESULTS" || die "failed to mount results share"
phase starting
mount /dev/disk/by-label/sbgh-src "$SRC" || die "failed to mount source disk"
# The host prepared this filesystem as the unprivileged worker account. The
# guest runs as root, and Git rejects a checkout owned by another uid. Match the
# proven benchmark-build handoff before invoking Git or Cargo.
chown -R root:root "$SRC" || die "chown $SRC to root failed"
# This cache is guest-local on the disposable boot overlay.
export SCCACHE_DIR="$SCCACHE"
export SCCACHE_CACHE_SIZE=20G
export RUSTC_WRAPPER=sccache
sccache --start-server >/dev/null 2>&1 || true

BIN="$SRC/target/release/stacks-inspect"
if [ ! -x "$BIN" ]; then
  phase building
  cd "$SRC"
  EXPECTED_COMMIT="$(python3 -c 'import json; print(json.load(open("/results/block-plan.json"))["commit"])')"
  git rev-parse HEAD | grep -qx "$EXPECTED_COMMIT" || die "checkout sha mismatch"
  cargo build --locked --release --package stacks-inspect || die "cargo build failed"
  strip --strip-debug "$BIN" || die "strip stacks-inspect failed"
  cp -f "$BIN" "$RESULTS/stacks-inspect" || die "failed to stage stacks-inspect"
  sync
  phase build_done
else
  cp -f "$BIN" "$RESULTS/stacks-inspect" || die "failed to stage cached stacks-inspect"
  phase build_cached
fi

phase probe
python3 - <<'PY' || die "block-validation guest runner failed"
import glob
import json
import os
import signal
import subprocess
import time

RESULTS = "/results"
PLAN_PATH = RESULTS + "/block-plan.json"
BIN = "/opt/stacks-core/target/release/stacks-inspect"
NETWORK_DATA_DIR = "mainnet"
MAX_PROBE_DIAGNOSTIC_BYTES = 64 * 1024
with open(PLAN_PATH, encoding="utf-8") as handle:
    plan = json.load(handle)
if plan.get("schema_version") != 2:
    raise RuntimeError("unsupported block plan schema")

def phase(name):
    with open(RESULTS + "/.phase-log", "a", encoding="utf-8") as handle:
        handle.write(f"{int(time.time())} {name}\n")
        handle.flush()
        os.fsync(handle.fileno())

def exact_device(serial):
    matches = {
        os.path.realpath(path)
        for path in glob.glob("/dev/disk/by-id/*" + serial + "*")
        if os.path.islink(path)
    }
    if len(matches) != 1:
        raise RuntimeError(f"serial {serial!r} resolved to {len(matches)} devices")
    return matches.pop()

database_paths = {}
for item in plan["devices"]:
    shard = int(item["shard"])
    mountpoint = item["mountpoint"]
    os.makedirs(mountpoint, exist_ok=True)
    subprocess.run(
        ["mount", "-t", "xfs", "-o", ",".join(plan["mount_options"]),
         exact_device(item["serial"]), mountpoint],
        check=True,
    )
    database_path = os.path.join(mountpoint, NETWORK_DATA_DIR)
    required_databases = (
        os.path.join(database_path, "chainstate", "vm", "index.sqlite"),
        os.path.join(database_path, "chainstate", "blocks", "nakamoto.sqlite"),
    )
    missing = [path for path in required_databases if not os.path.isfile(path)]
    if missing:
        raise RuntimeError(
            f"snapshot shard {shard} is missing required mainnet databases: {missing!r}"
        )
    database_paths[shard] = database_path

def diagnostic_tail(value):
    encoded = value.encode("utf-8", errors="replace")
    return encoded[-MAX_PROBE_DIAGNOSTIC_BYTES:].decode("utf-8", errors="replace")

probe_records = []
def probe(kind):
    ordinal = len(probe_records)
    stdout_name = f"probe-{kind}.stdout.log"
    stderr_name = f"probe-{kind}.stderr.log"
    argv = [
        BIN, "--network-config", "mainnet", "validate-block", database_paths[0], kind,
    ]
    audit = {
        "ordinal": ordinal,
        "kind": kind,
        "argv": argv,
        "stdout_file": stdout_name,
        "stderr_file": stderr_name,
    }
    print("SBGH_STACKS_INSPECT_COMMAND " + json.dumps(
        {"operation": "probe", **audit}, sort_keys=True, separators=(",", ":")
    ), flush=True)
    completed = subprocess.run(
        argv,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    with open(RESULTS + "/" + stdout_name, "w", encoding="utf-8") as handle:
        handle.write(completed.stdout)
        handle.flush()
        os.fsync(handle.fileno())
    with open(RESULTS + "/" + stderr_name, "w", encoding="utf-8") as handle:
        handle.write(completed.stderr)
        handle.flush()
        os.fsync(handle.fileno())
    audit["exit_code"] = completed.returncode
    probe_records.append(audit)
    if completed.returncode != 0:
        raise RuntimeError(
            f"{kind} probe failed (exit={completed.returncode}): "
            f"stdout_tail={diagnostic_tail(completed.stdout)!r} "
            f"stderr_tail={diagnostic_tail(completed.stderr)!r}"
        )
    output = completed.stdout
    try:
        return int(output.split()[-1])
    except (IndexError, ValueError) as error:
        raise RuntimeError(f"malformed {kind} probe output") from error

pre = probe("index-range")
if pre <= 0:
    raise RuntimeError("chainstate probe returned no pre-Nakamoto blocks")
naka = probe("naka-index-range")
if naka <= 0:
    raise RuntimeError("chainstate probe returned no Nakamoto blocks")
total = pre + naka
if total > 9223372036854775807:
    raise RuntimeError("chainstate probe count exceeds the durable integer range")
selection = plan["selection"]
kind = selection.get("kind")
if kind == "recent":
    block_count = int(selection.get("block_count", 0))
    if block_count <= 0:
        raise RuntimeError("recent block count must be non-zero")
    count = min(block_count, naka)
    requested = {"start": total - count, "end": total - 1}
elif kind == "full":
    requested = {"start": 0, "end": total - 1}
elif kind == "range":
    requested = selection.get("range")
    if not isinstance(requested, dict):
        raise RuntimeError("range selector is missing its range")
    if requested["start"] > requested["end"] or requested["end"] >= total:
        raise RuntimeError("explicit validation range is outside probed coverage")
else:
    raise RuntimeError("unsupported validation selector")

segments = []
if requested["start"] < pre:
    segment_end = min(requested["end"], pre - 1)
    segments.append({
        "epoch": "pre_nakamoto",
        "global_range": {"start": requested["start"], "end": segment_end},
        "local_range": {"start": requested["start"], "end": segment_end},
    })
if requested["end"] >= pre:
    segment_start = max(requested["start"], pre)
    segments.append({
        "epoch": "nakamoto",
        "global_range": {"start": segment_start, "end": requested["end"]},
        "local_range": {"start": segment_start - pre, "end": requested["end"] - pre},
    })
if not segments:
    raise RuntimeError("resolved range produced no epoch segments")

count = requested["end"] - requested["start"] + 1
target = int(plan["target_blocks_per_shard"])
max_shards = int(plan["max_shards"])
if target <= 0 or max_shards <= 0:
    raise RuntimeError("invalid local shard policy")
shard_count = min((count + target - 1) // target, max_shards)
if shard_count <= 0 or shard_count > len(plan["devices"]):
    raise RuntimeError("resolved shard count exceeds attached snapshot devices")
base, remainder = divmod(count, shard_count)
ranges = []
cursor = requested["start"]
for index in range(shard_count):
    length = base + (1 if index < remainder else 0)
    global_end = cursor + length - 1
    commands = []
    if cursor < pre:
        end = min(global_end, pre - 1)
        commands.append(("index-range", cursor, end))
    if global_end >= pre:
        start = max(cursor, pre)
        commands.append(("naka-index-range", start - pre, global_end - pre))
    if not commands:
        raise RuntimeError("shard produced no epoch-local command")
    ranges.append((index, cursor, global_end, commands))
    cursor += length
if cursor != requested["end"] + 1:
    raise RuntimeError("partition did not exactly cover requested range")

phase("validating")
pending = list(ranges)
active = {}
finished = []
started = time.monotonic()
limit = min(int(plan["max_concurrency"]), len(ranges))
if limit <= 0:
    raise RuntimeError("max_concurrency must be non-zero")

def start_command(state):
    range_kind, command_start, command_end = state["pending_commands"].pop(0)
    ordinal = len(state["commands"])
    end_exclusive = command_end + 1
    stdout_name = f"shard-{state['index']}-command-{ordinal}.stdout.log"
    stderr_name = f"shard-{state['index']}-command-{ordinal}.stderr.log"
    argv = [
        BIN, "--network-config", "mainnet", "validate-block",
        database_paths[state["index"]], range_kind,
        str(command_start), str(end_exclusive),
    ]
    audit = {
        "ordinal": ordinal,
        "kind": range_kind,
        "start": command_start,
        "end_exclusive": end_exclusive,
        "argv": argv,
        "stdout_file": stdout_name,
        "stderr_file": stderr_name,
    }
    print("SBGH_STACKS_INSPECT_COMMAND " + json.dumps(
        {"operation": "validate", "shard": state["index"], **audit},
        sort_keys=True, separators=(",", ":")
    ), flush=True)
    stdout_handle = open(RESULTS + "/" + stdout_name, "wb")
    stderr_handle = open(RESULTS + "/" + stderr_name, "wb")
    state["process"] = subprocess.Popen(
        argv,
        stdout=stdout_handle,
        stderr=stderr_handle,
        start_new_session=True,
    )
    state["stdout"] = stdout_handle
    state["stderr"] = stderr_handle
    state["current_command"] = audit

while pending or active:
    if time.monotonic() - started > int(plan["timeout_secs"]):
        for state in active.values():
            os.killpg(state["process"].pid, signal.SIGTERM)
            state["stdout"].close()
            state["stderr"].close()
        raise RuntimeError("block validation timed out")
    while pending and len(active) < limit:
        index, global_start, global_end, commands = pending.pop(0)
        state = {
            "index": index,
            "start": global_start,
            "end": global_end,
            "pending_commands": commands,
            "commands": [],
        }
        start_command(state)
        active[index] = state
    completed = []
    for index, state in active.items():
        exit_code = state["process"].poll()
        if exit_code is None:
            continue
        state["stdout"].close()
        state["stderr"].close()
        command_record = state.pop("current_command")
        command_record["exit_code"] = exit_code
        state["commands"].append(command_record)
        if exit_code in (0, 1) and state["pending_commands"]:
            start_command(state)
            continue
        finished.append({
            "index": state["index"],
            "start": state["start"],
            "end": state["end"],
            "commands": state["commands"],
        })
        completed.append(index)
    for index in completed:
        del active[index]
    if completed:
        checked = sum(item["end"] - item["start"] + 1 for item in finished)
        with open(RESULTS + "/run.progress.jsonl", "a", encoding="utf-8") as handle:
            handle.write(json.dumps({
                "schema_version": 1,
                "event_type": "progress",
                "event_version": 1,
                "progress": {
                    "phase": "validate",
                    "current": len(finished),
                    "total": len(ranges),
                    "message": f"checked {checked} blocks",
                },
            }, separators=(",", ":")) + "\n")
    else:
        time.sleep(0.2)

finished.sort(key=lambda item: item["index"])
result = {
    "schema_version": 2,
    "job_id": plan["job_id"],
    "attempt_id": plan["attempt_id"],
    "fencing_generation": plan["fencing_generation"],
    "chainstate_origin": plan["chainstate_origin"],
    "selection": selection,
    "observed": {
        "pre_nakamoto_count": pre,
        "nakamoto_count": naka,
    },
    "resolved_range": requested,
    "segments": segments,
    "shard_count": shard_count,
    "max_concurrency": limit,
    "probes": probe_records,
    "shards": finished,
}
temporary = RESULTS + "/.block-validation-result.json.tmp"
with open(temporary, "w", encoding="utf-8") as handle:
    json.dump(result, handle, sort_keys=True, separators=(",", ":"))
    handle.flush()
    os.fsync(handle.fileno())
os.replace(temporary, RESULTS + "/block-validation-result.json")
phase("reduced")
PY

phase done
