#!/bin/bash
# Runs inside the guest VM under cloud-init.
#
# Layout (mounted by this script):
#   {{ source_mount }}        — source disk (vdc), ext4, freshly cloned + checked out
#   {{ chainstate_mount }}    — chainstate snapshot (vdb), XFS
#   {{ results_mount }}       — virtio-fs share to host tmpfs (tag={{ results_share_tag }})
#
# Phases (appended to {{ results_mount }}/.phase-log; orchestrator polls for these):
#   starting   -> mounts complete, about to build
#   building   -> cargo build is running
#   running    -> stacks-bench is executing
#   collecting -> sqlite finalize / sync
#   done       -> normal completion
#   error      -> a step failed; details in console.log
#
# Format per line: `<unix-seconds> <phase>`. Append-only — the orchestrator
# replays new entries between polls so it never misses fast transitions
# (e.g. starting → building can be sub-second). The journal also gets
# archived per-job for forensics.

set -euo pipefail

HEAD_SHA="{{ head_sha }}"
SRC="{{ source_mount }}"
CHAIN="{{ chainstate_mount }}"
RESULTS="{{ results_mount }}"
SHARE_TAG="{{ results_share_tag }}"

# Split `{{ stacks_bench_args }}` into separate argv tokens at whitespace.
# Quoting EXTRA_ARGS would pass the whole string as one argument; using an
# array makes the word-split explicit and shellcheck-clean.
read -r -a EXTRA_ARGS <<<"{{ stacks_bench_args }}"

PHASE_LOG="$RESULTS/.phase-log"

# Append-only journal. Each phase transition becomes a timestamped line;
# the orchestrator's poll loop replays new entries between polls so it
# never misses fast transitions even at multi-second poll intervals.
phase()  { printf '%s %s\n' "$(date +%s)" "$1" >> "$PHASE_LOG"; sync; }
die()    { phase "error"; echo "ERROR: $*" >&2; exit 1; }

# --- mount results share (virtio-fs) -------------------------------------------------
mkdir -p "$RESULTS"
mount -t virtiofs "$SHARE_TAG" "$RESULTS" || die "failed to mount virtio-fs $SHARE_TAG"
phase "starting"

# --- mount source disk (vdc) ---------------------------------------------------------
# Mounted read-write: cargo writes target/ under the workspace. The disk is
# per-job and torn down after the run, so there's nothing to protect.
mkdir -p "$SRC"
mount /dev/disk/by-label/sbgh-src "$SRC" || die "failed to mount source disk"

# Reclaim ownership inside the VM.
#
# The source tree was cloned + checked out on the host as user `sbgh`
# (uid != 0); cloud-init / sbgh-run.sh runs as root inside the VM.
# Git's CVE-2022-24765 protection refuses to operate on a repo whose
# on-disk owner differs from the caller's uid ("fatal: detected dubious
# ownership in repository at '/opt/stacks-core'"), which makes our
# `git rev-parse` below return nothing, and the SHA check then trips
# `die "checkout sha mismatch"` — a misleading error for what's really
# a uid-mapping issue.
#
# `cargo build` would then hit the same wall for any git-vendored
# dependencies it pulls into the workspace, so it's simpler to fix
# this once for the whole tree than to thread `safe.directory` through
# every git invocation.
chown -R root:root "$SRC" || die "chown $SRC to root failed"

# --- mount chainstate snapshot (vdb) -------------------------------------------------
mkdir -p "$CHAIN"
mount -t xfs /dev/vdb "$CHAIN" || die "failed to mount chainstate xfs"

# Prove the chainstate is actually writable before we hand it to
# stacks-bench. We pass `--dangerous-no-chainstate-copy`, which means
# stacks-bench writes mini-fork blocks directly into the mount; if
# any of the three layers (LVM snapshot permission / domain XML disk
# device / xfs mount opts) accidentally regress to read-only, this
# probe fails loudly here instead of letting stacks-bench die with a
# cryptic sqlite error 10+ minutes into the benchmark.
PROBE="$CHAIN/.sbgh-write-probe"
touch "$PROBE" 2>/dev/null \
    || die "chainstate mount at $CHAIN is read-only — check LVM snapshot, domain XML, and mount opts"
rm -f "$PROBE"

# stacks-bench's `--source` flag wants the directory CONTAINING the
# `chainstate/` folder (not the chainstate dir itself). Hiro's tarballs
# unpack with a network-name wrapper (`mainnet/chainstate/...`,
# `testnet/chainstate/...`), so the actual source dir is one level
# under the LV mount. Probe for it instead of hardcoding `mainnet`
# so the same script works for testnet / regtest snapshots later.
SBGH_SOURCE_DIR=$(find "$CHAIN" -maxdepth 3 -mindepth 1 -name chainstate -type d -printf '%h\n' 2>/dev/null | head -1)
[[ -n "$SBGH_SOURCE_DIR" ]] || die "couldn't locate chainstate/ under $CHAIN"

# --- mount the persistent sccache cache share ---------------------------------------
# Persists rustc compiler output across jobs via a host bind-mount (virtio-fs).
# `RUSTC_WRAPPER=sccache` makes cargo route every `rustc` invocation through
# sccache; hits skip the actual compile and copy the cached artifact instead.
# sccache enforces SCCACHE_CACHE_SIZE via LRU eviction so the cache dir tops
# out at the configured ceiling regardless of how many jobs have populated it.
#
# Safety note: the share is rw, so a malicious build.rs CAN poison cache
# entries — but sccache validates the input hash on every read, so a
# poisoned entry only affects future jobs whose input keys you can already
# produce (i.e. the same trusted committer's PRs). Out of scope for our
# trust model (allowlist-gated /benchmark trigger).
SCCACHE_MOUNT="{{ sccache_mount }}"
SCCACHE_SHARE_TAG="{{ sccache_share_tag }}"
mkdir -p "$SCCACHE_MOUNT"
mount -t virtiofs "$SCCACHE_SHARE_TAG" "$SCCACHE_MOUNT" \
    || die "failed to mount virtio-fs $SCCACHE_SHARE_TAG"
export SCCACHE_DIR="$SCCACHE_MOUNT"
export SCCACHE_CACHE_SIZE="{{ sccache_max_size }}"
export RUSTC_WRAPPER=sccache
sccache --start-server >/dev/null 2>&1 || true

# --- build stacks-bench from the checked-out source ----------------------------------
phase "building"
cd "$SRC"
git rev-parse HEAD | grep -q "$HEAD_SHA" || die "checkout sha mismatch"
cargo build --release -p stacks-bench || die "cargo build failed"
# Surface the cache hit-rate in the console log — invaluable when
# diagnosing "why is this build still slow?" runs.
sccache --show-stats || true

# --- run benchmark -------------------------------------------------------------------
#
# Three structural flags the orchestrator owns (NOT user-tunable; injected
# here):
#   --json                        suppress styled/interactive output (spinners,
#                                 progress bars); send a structured JSON
#                                 summary to stdout for the host to capture.
#   --db "$RESULTS"               point stacks-bench's app-data dir at the
#                                 virtio-fs share. Materialises the SQLite
#                                 store at $RESULTS/appdata/stacks-bench.db,
#                                 which the orchestrator archives off after
#                                 the VM shuts down (see tmpfs.rs::sqlite_file).
#   --source "$CHAIN"             chainstate dir; this is the LVM-thin
#                                 snapshot mounted at $CHAIN.
#   --dangerous-no-chainstate-copy
#                                 skip stacks-bench's own reflink/CoW copy.
#                                 We've ALREADY CoW'd at the LVM-thin layer,
#                                 so a second copy inside the VM would double
#                                 our snapshot footprint and break our
#                                 chainstate-isolation guarantee.
#
# EXTRA_ARGS is the user-tunable workload (start-at, count, warmup,
# bench-spans-only, etc.); see [stacks_bench].default_args in the
# orchestrator config for the per-deployment default and `/benchmark`
# command for per-PR overrides.
phase "running"
./target/release/stacks-bench \
    --json \
    --db "$RESULTS" \
    bench run \
    --source "$SBGH_SOURCE_DIR" \
    --dangerous-no-chainstate-copy \
    "${EXTRA_ARGS[@]}" \
    > "$RESULTS/run.json" \
    || die "stacks-bench exited non-zero"

# --- finalize -----------------------------------------------------------------------
phase "collecting"
# Snapshot the stacks-bench binary alongside its SQLite output. The
# binary is the canonical reader of its own DB (`bench list`,
# `bench summary`, `bench compare`); a different-version binary may
# not understand the schema. Saving it next to the DB means
# "investigate later" is a 1-liner with no version-juggling:
#     cd /var/lib/sbgh/results/<job-id>
#     ./stacks-bench --db . bench list
# Compressing would save ~70% disk but adds a decompress step before
# every investigation — keep uncompressed for ergonomics.
cp -f ./target/release/stacks-bench "$RESULTS/stacks-bench" \
    || die "failed to snapshot stacks-bench binary into results"
sync
phase "done"
# cloud-init's `power_state: poweroff` will shut us down cleanly.
