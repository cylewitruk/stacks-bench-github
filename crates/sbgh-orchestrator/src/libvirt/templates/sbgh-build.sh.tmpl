#!/bin/bash
# In-VM cloud-init script for the **build phase** of a job. Runs once
# per VM first-boot (instance-id = sbgh-<job-id>-build) and exits with
# the VM powered off via cloud-init's `power_state: poweroff`.
#
# After this script terminates and the VM shuts down, the orchestrator
# reconfigures the same domain at a smaller memory (`bench_memory`)
# and boots it again with a different cidata ISO — that second boot
# runs `sbgh-bench.sh.tmpl`. See driver.rs::run_benchmark for the
# two-phase lifecycle.
#
# What this phase does:
#   - mount source disk + sccache + results (NOT chainstate)
#   - cargo build stacks-bench (sccache-accelerated)
#   - snapshot the resulting binary to $RESULTS
#   - write phase=build_done; poweroff
#
# Phases written to {{ results_mount }}/.phase-log:
#   starting    → mounts complete
#   building    → cargo build is running
#   build_done  → terminal for this VM; orchestrator transitions to bench

set -euo pipefail

HEAD_SHA="{{ head_sha }}"
SRC="{{ source_mount }}"
RESULTS="{{ results_mount }}"
SHARE_TAG="{{ results_share_tag }}"

PHASE_LOG="$RESULTS/.phase-log"
phase()  { printf '%s %s\n' "$(date +%s)" "$1" >> "$PHASE_LOG"; sync; }
die()    { phase "error"; echo "ERROR: $*" >&2; exit 1; }

# --- mount results share (virtio-fs) ------------------------------------------------
mkdir -p "$RESULTS"
mount -t virtiofs "$SHARE_TAG" "$RESULTS" || die "failed to mount virtio-fs $SHARE_TAG"
phase "starting"

# --- mount source disk (vdc) --------------------------------------------------------
# Persistent across the build → bench VM transition. The bench VM
# remounts it and finds target/release/stacks-bench from this build.
mkdir -p "$SRC"
mount /dev/disk/by-label/sbgh-src "$SRC" || die "failed to mount source disk"

# Reclaim ownership inside the VM. Source was cloned + checked out
# on the host as user `sbgh` (uid != 0); we run as root. Git's
# CVE-2022-24765 protection refuses to operate on a repo whose owner
# differs from the caller's uid. chown once here covers all subsequent
# git/cargo calls (in this VM and the bench VM, since the source disk
# persists).
chown -R root:root "$SRC" || die "chown $SRC to root failed"

# --- mount the persistent sccache cache share ---------------------------------------
SCCACHE_MOUNT="{{ sccache_mount }}"
SCCACHE_SHARE_TAG="{{ sccache_share_tag }}"
mkdir -p "$SCCACHE_MOUNT"
mount -t virtiofs "$SCCACHE_SHARE_TAG" "$SCCACHE_MOUNT" \
    || die "failed to mount virtio-fs $SCCACHE_SHARE_TAG"
export SCCACHE_DIR="$SCCACHE_MOUNT"
export SCCACHE_CACHE_SIZE="{{ sccache_max_size }}"
export RUSTC_WRAPPER=sccache
sccache --start-server >/dev/null 2>&1 || true

# --- build ---------------------------------------------------------------------------
phase "building"
cd "$SRC"
git rev-parse HEAD | grep -q "$HEAD_SHA" || die "checkout sha mismatch"
cargo build --release -p stacks-bench || die "cargo build failed"
sccache --show-stats || true

# --- snapshot the binary -------------------------------------------------------------
# Save into the results share now (instead of waiting until the bench
# VM) so even a bench-phase failure leaves a runnable binary in the
# job archive — useful for "did the build produce something sane?"
# triage. Also costs nothing in the success path.
cp -f ./target/release/stacks-bench "$RESULTS/stacks-bench" \
    || die "failed to snapshot stacks-bench binary into results"
sync

phase "build_done"
# cloud-init's `power_state: poweroff` will shut us down cleanly.
